API_URL=http://127.0.0.1:8000/api

# Alamat yang boleh mengirim POST ke proxy (pemeriksaan CSRF). Pisahkan dengan koma.
# Daftarkan setiap alamat yang benar-benar dipakai membuka aplikasi: browser
# mengirim Origin persis seperti yang tertulis di address bar, sehingga
# http://localhost:3001 dan http://127.0.0.1:3001 dihitung berbeda.
APP_ORIGIN=http://127.0.0.1:3001,http://localhost:3001

# Menit tanpa aktivitas sebelum sesi ditutup otomatis (cookie dan timer browser memakai nilai yang sama).
NEXT_PUBLIC_SESSION_IDLE_MINUTES=15
